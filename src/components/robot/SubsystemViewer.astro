---
import robotData from '../../data/robot.json';
import Icon from '../common/Icon.astro';
---

<div class="space-y-8">
  <!-- Robot Main Overview Card -->
  <div class="rounded-3xl glass-card border border-white/10 p-6 sm:p-8 lg:p-10 relative overflow-hidden">
    
    <!-- Background Glow -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-[var(--brand-primary)]/20 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Info -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--brand-primary)]/20 border border-[var(--brand-primary)]/30 text-xs font-semibold text-[var(--brand-primary-light)]">
          <Icon name="bot" size={16} />
          <span>Competition Robot • {robotData.season}</span>
        </div>

        <div class="space-y-2">
          <h2 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
            {robotData.name}
          </h2>
          <p class="text-base text-slate-300 leading-relaxed">
            {robotData.description}
          </p>
        </div>

        <!-- Key Quick Specs Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Drivetrain</span>
            <span class="text-sm font-semibold text-white mt-0.5 block">{robotData.drivetrain.split(' ')[0]} + Odo</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Total Weight</span>
            <span class="text-sm font-semibold text-white mt-0.5 block">{robotData.weight}</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/5 col-span-2 sm:col-span-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">Cycle Speed</span>
            <span class="text-sm font-semibold text-[var(--brand-accent)] mt-0.5 block">{robotData.cycleTime}</span>
          </div>
        </div>

        <!-- CAD & Code Links -->
        <div class="flex flex-wrap gap-3 pt-2">
          {robotData.cadLink && (
            <a 
              href={robotData.cadLink} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-light)] shadow-lg shadow-[var(--brand-primary)]/30 transition-all flex items-center gap-2"
            >
              <Icon name="layers" size={16} />
              <span>Interactive Onshape CAD</span>
              <Icon name="external-link" size={14} />
            </a>
          )}
          {robotData.githubLink && (
            <a 
              href={robotData.githubLink} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-200 bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-2"
            >
              <Icon name="github" size={16} />
              <span>View Robot Code (Java)</span>
            </a>
          )}
        </div>
      </div>

      <!-- Right 3D / Robot Schematic Preview -->
      <div class="lg:col-span-5 bg-gradient-to-b from-slate-900 to-slate-950 rounded-2xl border border-white/10 p-6 flex flex-col items-center justify-center text-center relative group min-h-[320px]">
        <div class="w-24 h-24 rounded-full bg-[var(--brand-primary)]/20 border border-[var(--brand-primary)]/40 flex items-center justify-center text-[var(--brand-primary-light)] mb-4 group-hover:scale-110 transition-transform duration-300">
          <Icon name="bot" size={48} />
        </div>
        <div class="font-display font-bold text-lg text-white">NectarViper V3 3D Model</div>
        <p class="text-xs text-slate-400 mt-1 max-w-xs">
          Interactive full-assembly CAD model featuring 180+ custom engineered components.
        </p>
        <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 text-xs text-slate-300 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Certified Inspection Ready</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Subsystems Breakdown Explorer -->
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-2xl font-bold font-display text-white">Subsystems & Engineering Design</h3>
        <p class="text-sm text-slate-400">Detailed breakdown of custom hardware mechanisms, actuators, and software logic.</p>
      </div>

      <!-- Subsystem Filter Tabs -->
      <div class="flex flex-wrap gap-2" id="subsystem-tabs">
        {robotData.subsystems.map((sub, idx) => (
          <button 
            data-subsystem-idx={idx}
            class={`subsystem-tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all ${
              idx === 0 
                ? 'bg-[var(--brand-primary)] text-white shadow-md shadow-[var(--brand-primary)]/30' 
                : 'bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white border border-white/10'
            }`}
          >
            {sub.name.split(' ')[0]}
          </button>
        ))}
      </div>
    </div>

    <!-- Active Subsystem Card -->
    <div id="subsystem-detail-card" class="rounded-2xl glass-card border border-white/10 p-6 sm:p-8">
      <!-- Injected via client script -->
    </div>
  </div>
</div>

<script define:vars={{ subsystems: robotData.subsystems }}>
  const card = document.getElementById('subsystem-detail-card');
  const tabs = document.querySelectorAll('.subsystem-tab-btn');

  function renderSubsystem(idx) {
    const sub = subsystems[idx];
    if (!sub || !card) return;

    card.innerHTML = `
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-4">
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-[var(--brand-accent)]">${sub.category}</span>
            <h4 class="text-2xl font-bold font-display text-white mt-0.5">${sub.name}</h4>
          </div>
          <div class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">
            Subsystem ID: ${sub.id}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Specifications List -->
          <div class="space-y-3">
            <h5 class="text-xs uppercase font-bold tracking-wider text-slate-400">Technical Specifications</h5>
            <ul class="space-y-2">
              ${sub.specs.map(spec => `
                <li class="flex items-start gap-2 text-xs text-slate-200">
                  <span class="text-[var(--brand-primary-light)] font-bold mt-0.5">▸</span>
                  <span>${spec}</span>
                </li>
              `).join('')}
            </ul>
          </div>

          <!-- Highlights & Iteration Log -->
          <div class="space-y-4">
            <div class="p-4 rounded-xl bg-[var(--brand-primary)]/10 border border-[var(--brand-primary)]/25">
              <h5 class="text-xs uppercase font-bold tracking-wider text-[var(--brand-primary-light)] mb-1">Key Performance Metric</h5>
              <p class="text-xs text-slate-200 leading-relaxed">${sub.highlights}</p>
            </div>

            <div class="p-4 rounded-xl bg-white/5 border border-white/10">
              <h5 class="text-xs uppercase font-bold tracking-wider text-[var(--brand-accent)] mb-1">Engineering Iteration Cycle</h5>
              <p class="text-xs text-slate-300 leading-relaxed">${sub.iterationNotes}</p>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.className = 'subsystem-tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white border border-white/10';
      });
      tab.className = 'subsystem-tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-[var(--brand-primary)] text-white shadow-md shadow-[var(--brand-primary)]/30';
      const idx = Number(tab.getAttribute('data-subsystem-idx'));
      renderSubsystem(idx);
    });
  });

  // Initial render
  renderSubsystem(0);
</script>
