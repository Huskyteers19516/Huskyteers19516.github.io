---
import { withBase } from '../../utils/url';
import { siteConfig } from '../../config/site.config';
import Icon from './Icon.astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-[var(--brand-primary)]/20 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[350px] h-[350px] bg-[var(--brand-accent)]/15 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center space-y-6 md:space-y-8">
      
      <!-- Season Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold text-slate-300 backdrop-blur-md hover:border-white/20 transition-all">
        <span class="w-2 h-2 rounded-full bg-[var(--brand-primary-light)] animate-pulse"></span>
        <span class="tracking-wider uppercase text-[var(--brand-primary-light)]">FTC Season {siteConfig.season}</span>
        <span class="text-slate-500">•</span>
        <span class="text-white font-bold">{siteConfig.seasonGame}</span>
      </div>

      <!-- Main Heading & Motto -->
      <div class="max-w-4xl space-y-4">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight font-display text-white">
          We Are <span class="bg-gradient-to-r from-[var(--brand-primary-light)] via-emerald-300 to-[var(--brand-accent)] bg-clip-text text-transparent">{siteConfig.name}</span>
        </h1>
        <p class="text-lg sm:text-2xl font-mono text-slate-300 font-medium">
          FIRST Tech Challenge Team #{siteConfig.number}
        </p>
        <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
          {siteConfig.tagline} Powered by rapid engineering iterations, high-precision autonomous trajectories, and passionate STEM community mentorship.
        </p>
      </div>

      <!-- Call to Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        {siteConfig.features.robotShowcase && (
          <a 
            href={withBase('/robot')} 
            class="px-6 py-3.5 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-[var(--brand-primary)] to-[var(--brand-primary-light)] hover:opacity-95 shadow-xl shadow-[var(--brand-primary)]/30 hover:scale-105 transition-all flex items-center gap-2"
          >
            <Icon name="bot" size={18} />
            <span>Explore NectarViper V3</span>
          </a>
        )}
        {siteConfig.links.portfolioPdf && (
          <a 
            href={withBase(siteConfig.links.portfolioPdf)} 
            target="_blank"
            class="px-6 py-3.5 rounded-xl font-bold text-sm text-slate-200 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/25 backdrop-blur-md hover:scale-105 transition-all flex items-center gap-2"
          >
            <Icon name="file-text" size={18} />
            <span>Engineering Portfolio (PDF)</span>
          </a>
        )}
        {siteConfig.features.sponsorshipTiers && (
          <a 
            href={withBase('/sponsors')} 
            class="px-6 py-3.5 rounded-xl font-bold text-sm text-[var(--brand-accent)] bg-[var(--brand-accent)]/10 hover:bg-[var(--brand-accent)]/20 border border-[var(--brand-accent)]/30 hover:scale-105 transition-all flex items-center gap-2"
          >
            <Icon name="heart-handshake" size={18} />
            <span>Sponsor Us</span>
          </a>
        )}
      </div>

      <!-- Live Quick Stats Strip -->
      <div class="w-full max-w-5xl pt-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {siteConfig.stats.map((stat) => (
            <div class="p-5 rounded-2xl glass-card text-left border border-white/10 hover:border-[var(--brand-primary-light)]/40 transition-all group">
              <div class="text-2xl sm:text-3xl font-extrabold font-display text-white group-hover:text-[var(--brand-primary-light)] transition-colors">
                {stat.value}
              </div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-300 mt-1">
                {stat.label}
              </div>
              {stat.subtext && (
                <div class="text-[11px] text-slate-500 mt-0.5">
                  {stat.subtext}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
