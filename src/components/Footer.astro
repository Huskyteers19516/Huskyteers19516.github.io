---
import StyledLink from "./StyledLink.astro";
import { Mail, Pin } from "@lucide/astro";
import { Github, Instagram, Youtube, Discord } from "simple-icons-astro";
---

<footer class="bg-neutral text-neutral-content">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="flex gap-3 flex-col">
                <h3
                    class="text-lg font-semibold mb-3"
                    data-edit-text="footer.contact.title"
                    data-edit-label="Footer: contact heading"
                >
                    Contact The Huskyteers
                </h3>
                <StyledLink
                    href={`mailto:fpahuskyteers19516@gmail.com`}
                    class="flex items-center gap-2 truncate"
                    data-edit-link="footer.email.link"
                    data-edit-label="Footer: email link (mailto:…)"
                >
                    <Mail size={24} class="shrink-0" />
                    <span
                        data-edit-text="footer.email.text"
                        data-edit-label="Footer: email address shown"
                        >fpahuskyteers19516@gmail.com</span
                    >
                </StyledLink>
                <StyledLink
                    href="https://www.google.com/maps/search/?api=1&query=Fairmont+Preparatory+Academy&query_place_id=ChIJl5NscI8p3YARFUgyxdOSU2c"
                    target="_blank"
                    class="flex items-center gap-2"
                    data-edit-link="footer.address.link"
                    data-edit-label="Footer: address map link"
                >
                    <Pin size={24} class="shrink-0" />
                    <span class="flex flex-col">
                        <span
                            data-edit-text="footer.address.line-1"
                            data-edit-label="Footer: address line 1"
                            >2200 W Sequoia Ave</span
                        >
                        <span
                            data-edit-text="footer.address.line-2"
                            data-edit-label="Footer: address line 2"
                            >Anaheim, CA 92801</span
                        >
                    </span>
                </StyledLink>
            </div>

            <div>
                <h3
                    class="text-lg font-semibold mb-4"
                    data-edit-text="footer.links.title"
                    data-edit-label="Footer: quick links heading"
                >
                    Quick Links
                </h3>
                <ul class="space-y-2">
                    <li>
                        <StyledLink href="/"
                            ><span
                                data-edit-text="footer.links.home"
                                data-edit-label="Footer link: Home"
                                >Home</span
                            ></StyledLink
                        >
                    </li>
                    <li>
                        <StyledLink href="/about/team"
                            ><span
                                data-edit-text="footer.links.about"
                                data-edit-label="Footer link: About (Our Team)"
                                >About</span
                            ></StyledLink
                        >
                    </li>
                    <li>
                        <StyledLink href="/progress"
                            ><span
                                data-edit-text="footer.links.progress"
                                data-edit-label="Footer link: Live Progress"
                                >Live Progress</span
                            ></StyledLink
                        >
                    </li>
                    <li>
                        <StyledLink href="/workshop"
                            ><span
                                data-edit-text="footer.links.workshop"
                                data-edit-label="Footer link: Workshop"
                                >Workshop</span
                            ></StyledLink
                        >
                    </li>
                    <li>
                        <StyledLink href="/events"
                            ><span
                                data-edit-text="footer.links.events"
                                data-edit-label="Footer link: Outreach Events"
                                >Outreach Events</span
                            ></StyledLink
                        >
                    </li>
                    <li>
                        <StyledLink href="/sponsors">
                            <span
                                data-edit-text="footer.links.sponsors"
                                data-edit-label="Footer link: Sponsors"
                                >Sponsors</span
                            >
                        </StyledLink>
                    </li>
                </ul>
            </div>

            <div>
                <h3
                    class="text-lg font-semibold mb-4"
                    data-edit-text="footer.socials.title"
                    data-edit-label="Footer: socials heading"
                >
                    Socials
                </h3>
                <div class="flex space-x-4">
                    <StyledLink
                        href="https://www.instagram.com/ftc19516/"
                        data-edit-link="footer.socials.instagram"
                        data-edit-label="Footer: Instagram link"
                    >
                        <Instagram size={24} />
                    </StyledLink>
                    <StyledLink
                        href="https://www.youtube.com/channel/UC0NosafokRUY4pVAHCzd94Q"
                        data-edit-link="footer.socials.youtube"
                        data-edit-label="Footer: YouTube link"
                    >
                        <Youtube size={24} />
                    </StyledLink>
                    <StyledLink
                        href="https://discord.gg/JZuEqanpV3"
                        data-edit-link="footer.socials.discord"
                        data-edit-label="Footer: Discord link"
                    >
                        <Discord size={24} />
                    </StyledLink>
                    <StyledLink
                        href="https://github.com/Huskyteers19516"
                        data-edit-link="footer.socials.github"
                        data-edit-label="Footer: GitHub link"
                    >
                        <Github size={24} />
                    </StyledLink>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <div class="text-center text-muted-foreground">
            <p>
                &copy; {new Date().getFullYear()}{" "}<span
                    data-edit-text="footer.copyright"
                    data-edit-label="Footer: copyright line (after the year)"
                    >The Huskyteers. All rights reserved.</span
                >
            </p>
        </div>
    </div>
</footer>
