---
import StyledLink from "./StyledLink.astro";
import { Mail, Pin } from "@lucide/astro";
import { Github, Instagram, Youtube, Discord } from "simple-icons-astro";
---

<footer class="bg-neutral text-neutral-content">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="flex gap-3 flex-col">
                <h3 class="text-lg font-semibold mb-3">
                    Contact The Huskyteers
                </h3>
                <StyledLink
                    href={`mailto:fpahuskyteers19516@gmail.com`}
                    class="flex items-center gap-2 truncate"
                >
                    <Mail size={24} class="shrink-0" />
                    fpahuskyteers19516@gmail.com
                </StyledLink>
                <StyledLink
                    href="https://www.google.com/maps/search/?api=1&query=Fairmont+Preparatory+Academy&query_place_id=ChIJl5NscI8p3YARFUgyxdOSU2c"
                    target="_blank"
                    class="flex items-center gap-2 whitespace-pre-wrap"
                >
                    <Pin size={24} />
                    2200 W Sequoia Ave<br />Anaheim, CA 92801
                </StyledLink>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
                <ul class="space-y-2">
                    <li>
                        <StyledLink href="/">Home</StyledLink>
                    </li>
                    <li>
                        <StyledLink href="/about">About</StyledLink>
                    </li>
                    <li>
                        <StyledLink href="/progress">Live Progress</StyledLink>
                    </li>
                    <li>
                        <StyledLink href="/workshop">Workshop</StyledLink>
                    </li>
                    <li>
                        <StyledLink href="/events">Events</StyledLink>
                    </li>
                    <li>
                        <StyledLink href="/sponsors"> Sponsors </StyledLink>
                    </li>
                </ul>
            </div>

            <div>
                <h3 class="text-lg font-semibold mb-4">Socials</h3>
                <div class="flex space-x-4">
                    <StyledLink href="https://www.instagram.com/ftc19516/">
                        <Instagram size={24} />
                    </StyledLink>
                    <StyledLink
                        href="https://www.youtube.com/channel/UC0NosafokRUY4pVAHCzd94Q"
                    >
                        <Youtube size={24} />
                    </StyledLink>
                    <StyledLink href="https://discord.gg/JZuEqanpV3">
                        <Discord size={24} />
                    </StyledLink>
                    <StyledLink href="https://github.com/Huskyteers19516">
                        <Github size={24} />
                    </StyledLink>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <div class="text-center text-muted-foreground">
            <p>
                &copy; {new Date().getFullYear()} The Huskyteers. All rights reserved.
            </p>
        </div>
    </div>
</footer>
