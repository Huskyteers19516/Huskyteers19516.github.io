---
import HeaderLink from "./HeaderLink.astro";
import Link from "../Link.astro";
import Logo from "../Logo.astro";
import NameWithLogo from "./NameWithLogo.astro";
import NavigationMenu from "./NavigationMenu.astro";
---

<header
    class="navbar sticky top-0 z-50 bg-primary/20 backdrop-blur-3xl shadow-md min-h-12 shadow-foreground/20 py-3 px-4"
>
    <Link href="/" class="navbar-start w-auto shrink-0">
        <NameWithLogo />
    </Link>
    <div class="navbar-end w-auto flex-1">
        <NavigationMenu />
    </div>
</header>
