---
import HeaderLink from "./HeaderLink.astro";
import { Menu } from "@lucide/astro";
import { PUBLIC_PORTAL_URL } from "astro:env/client";

const portalUrl = PUBLIC_PORTAL_URL.replace(/\/+$/, "");
---

<!-- Desktop -->
<ul class="menu menu-horizontal px-1 hidden xl:flex">
    <li>
        <a href={portalUrl} target="_blank" rel="noopener noreferrer">
            <span data-edit-text="nav.portal" data-edit-label="Menu: Teammate Portal">Teammate Portal</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" />
                <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd" />
            </svg>
        </a>
    </li>
    <HeaderLink href="/"><span data-edit-text="nav.home" data-edit-label="Menu: Home">Home</span></HeaderLink>
    <li>
        <details>
            <summary><span data-edit-text="nav.about" data-edit-label="Menu: About">About</span></summary>
            <ul class="bg-base-100 rounded-t-none p-2">
                <HeaderLink href="/about/team"><span data-edit-text="nav.team" data-edit-label="Menu: Our Team">Our Team</span></HeaderLink>
                <HeaderLink href="/about/ftc"><span data-edit-text="nav.ftc" data-edit-label="Menu: What is FTC?">What is FTC?</span></HeaderLink>
                <HeaderLink href="/about/mentors"><span data-edit-text="nav.mentors" data-edit-label="Menu: Mentors">Mentors</span></HeaderLink>
            </ul>
        </details>
    </li>
    <HeaderLink href="/progress">
        <span class="status status-primary motion-safe:animate-pulse" aria-hidden="true"></span>
        <span data-edit-text="nav.progress" data-edit-label="Menu: Progress">Progress</span>
    </HeaderLink>
    <HeaderLink href="/workshop"><span data-edit-text="nav.workshop" data-edit-label="Menu: Workshop">Workshop</span></HeaderLink>
    <HeaderLink href="/events"><span data-edit-text="nav.events" data-edit-label="Menu: Outreach Events">Outreach Events</span></HeaderLink>
    <HeaderLink href="/contact"><span data-edit-text="nav.contact" data-edit-label="Menu: Contact">Contact</span></HeaderLink>
    <HeaderLink href="/sponsors"><span data-edit-text="nav.sponsors" data-edit-label="Menu: Sponsors Info/Donations">Sponsors Info/Donations</span></HeaderLink>
</ul>

<!-- Mobile -->
<details class="dropdown dropdown-end xl:hidden" data-mobile-nav>
    <summary class="btn btn-ghost btn-square" aria-label="Menu">
        <Menu size={26} aria-hidden="true" />
    </summary>
    <ul class="menu dropdown-content bg-base-100 rounded-box z-50 mt-3 w-64 p-2 shadow-lg">
        <HeaderLink href="/"><span data-edit-text="nav.home" data-edit-label="Menu: Home">Home</span></HeaderLink>
        <HeaderLink href="/progress">
            <span class="status status-primary motion-safe:animate-pulse" aria-hidden="true"></span>
            <span data-edit-text="nav.progress" data-edit-label="Menu: Progress">Progress</span>
        </HeaderLink>
        <HeaderLink href="/workshop"><span data-edit-text="nav.workshop" data-edit-label="Menu: Workshop">Workshop</span></HeaderLink>
        <li class="menu-title"><span data-edit-text="nav.about" data-edit-label="Menu: About">About</span></li>
        <HeaderLink href="/about/team"><span data-edit-text="nav.team" data-edit-label="Menu: Our Team">Our Team</span></HeaderLink>
        <HeaderLink href="/about/ftc"><span data-edit-text="nav.ftc" data-edit-label="Menu: What is FTC?">What is FTC?</span></HeaderLink>
        <HeaderLink href="/about/mentors"><span data-edit-text="nav.mentors" data-edit-label="Menu: Mentors">Mentors</span></HeaderLink>
        <li class="menu-title"><span data-edit-text="nav.more" data-edit-label="Phone menu: More">More</span></li>
        <HeaderLink href="/events"><span data-edit-text="nav.events" data-edit-label="Menu: Outreach Events">Outreach Events</span></HeaderLink>
        <HeaderLink href="/contact"><span data-edit-text="nav.contact" data-edit-label="Menu: Contact">Contact</span></HeaderLink>
        <HeaderLink href="/sponsors"><span data-edit-text="nav.sponsors" data-edit-label="Menu: Sponsors Info/Donations">Sponsors Info/Donations</span></HeaderLink>
        <li>
            <a href={portalUrl} target="_blank" rel="noopener noreferrer">
                <span data-edit-text="nav.portal" data-edit-label="Menu: Teammate Portal">Teammate Portal</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" />
                    <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd" />
                </svg>
            </a>
        </li>
    </ul>
</details>

<script>
    // Close the mobile menu on outside click or Escape.
    const nav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
    if (nav) {
        document.addEventListener("click", (e) => {
            if (nav.open && !nav.contains(e.target as Node)) nav.open = false;
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && nav.open) {
                nav.open = false;
                nav.querySelector("summary")?.focus();
            }
        });
    }
</script>
