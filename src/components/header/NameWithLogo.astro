---
import Logo from "../Logo.astro";

// The team name is the page's main heading only on the home page (which has
// no other). Every other page has its own <h1>.
const Name = Astro.url.pathname === "/" ? "h1" : "p";
---

<div class="font-jockey text-foreground flex flex-row place-items-center">
    <Logo class="w-14
    h-14
    sm:w-20
    sm:h-20
    fill-primary
    mr-3
    sm:mr-4" />
    <Name class="flex flex-col gap-1 justify-center">
        <span class="text-3xl sm:text-4xl font-bold uppercase text-primary">
            The Huskyteers
        </span>{" "}
        <span class="text-4xl sm:text-5xl font-bold text-muted-foreground">19516</span>
    </Name>
</div>
