---
import Icon from '../common/Icon.astro';

interface Props {
  name: string;
  role: string;
  subteam: string;
  grade: string;
  quote?: string;
  favoriteMechanism?: string;
}

const { name, role, subteam, grade, quote, favoriteMechanism } = Astro.props;

const subteamColors: Record<string, string> = {
  Mechanical: 'text-amber-400 bg-amber-400/10 border-amber-400/30',
  Software: 'text-cyan-400 bg-cyan-400/10 border-cyan-400/30',
  Outreach: 'text-emerald-400 bg-emerald-400/10 border-emerald-400/30',
  CAD: 'text-purple-400 bg-purple-400/10 border-purple-400/30',
  Strategy: 'text-rose-400 bg-rose-400/10 border-rose-400/30',
};

const badgeClass = subteamColors[subteam] || 'text-slate-300 bg-white/10 border-white/20';
---

<div class="team-member-card p-6 rounded-2xl glass-card border border-white/10 hover:border-[var(--brand-primary-light)]/40 transition-all space-y-4 group flex flex-col justify-between" data-subteam={subteam}>
  <div>
    <!-- Top Meta -->
    <div class="flex items-center justify-between gap-2">
      <span class={`text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full border ${badgeClass}`}>
        {subteam}
      </span>
      <span class="text-xs text-slate-400 font-mono">{grade}</span>
    </div>

    <!-- Member Name & Role -->
    <div class="mt-4">
      <h4 class="text-xl font-bold font-display text-white group-hover:text-[var(--brand-primary-light)] transition-colors">
        {name}
      </h4>
      <p class="text-xs font-medium text-slate-300 mt-0.5">
        {role}
      </p>
    </div>

    {quote && (
      <p class="text-xs text-slate-400 italic mt-3 leading-relaxed border-l-2 border-[var(--brand-primary)] pl-3">
        "{quote}"
      </p>
    )}
  </div>

  {favoriteMechanism && (
    <div class="pt-3 border-t border-white/5 text-[11px] text-slate-400 flex items-start gap-1.5">
      <Icon name="cpu" size={13} class="text-[var(--brand-accent)] flex-shrink-0 mt-0.5" />
      <span><strong class="text-slate-300">Fav Mech:</strong> {favoriteMechanism}</span>
    </div>
  )}
</div>
