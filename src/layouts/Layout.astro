---
import Footer from "../components/Footer.astro";
import Header from "../components/header/Header.astro";
import SiteContent from "../components/site-content/SiteContent.astro";
import "../styles/global.css";
import Font from "astro/components/Font.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "The Huskyteers | FTC 19516",
    description = "The Huskyteers are a FIRST Tech Challenge team based in the Anaheim, California.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <Font cssVariable="--font-jockey-one-astro" />
        <Font cssVariable="--font-inter-astro" />
        <Font cssVariable="--font-geist-mono-astro" />
        <slot name="head" />
    </head>
    <body class="font-inter">
        <Header />
        <slot />
        <Footer />
        <SiteContent />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
