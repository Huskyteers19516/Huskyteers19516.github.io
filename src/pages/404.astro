---
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main
        class="min-h-[60vh] flex place-items-center place-content-center flex-col gap-3"
    >
        <span data-edit-text="404.message" data-edit-label="Page not found: message"
            >Your page was lost into the deep!</span
        >
        <Link href="/">
            <button class="btn btn-primary"
                ><span
                    data-edit-text="404.button"
                    data-edit-label="Page not found: button"
                    >Go back Centerstage (home)</span
                ></button
            >
        </Link>
    </main>
</Layout>
