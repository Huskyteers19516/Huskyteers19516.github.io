---
import Layout from '../layouts/Layout.astro';
import ImpactMap from '../components/outreach/ImpactMap.astro';
import { siteConfig } from '../config/site.config';
import Icon from '../components/common/Icon.astro';
---

<Layout title={`Outreach & Community Impact | ${siteConfig.name} #${siteConfig.number}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 space-y-16">
    
    <!-- Page Header -->
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 text-xs font-bold text-emerald-400 border border-emerald-500/30">
        <Icon name="heart-handshake" size={16} />
        <span>Connect & Motivate Award Focus</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold font-display text-white tracking-tight">
        Community Outreach & Impact
      </h1>
      <p class="text-base text-slate-300 leading-relaxed">
        We believe that robotics is about more than just building competitive machines—it's about empowering the next generation of engineers, mentoring FIRST LEGO League teams, and making STEM accessible to all.
      </p>
    </div>

    <ImpactMap />

  </div>
</Layout>
