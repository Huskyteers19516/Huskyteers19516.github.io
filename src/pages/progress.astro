---
import { PUBLIC_PORTAL_URL } from "astro:env/client";
import LiveProgress from "../components/progress/live-progress";
import Layout from "../layouts/Layout.astro";
import "../styles/progress.css";

const portalUrl = PUBLIC_PORTAL_URL.replace(/\/+$/, "");
---

<Layout
    title="Live Progress | The Huskyteers | FTC 19516"
    description="Live task progress of FTC team 19516, The Huskyteers: team, subteam and member checklist progress, streamed from our Teammate Portal."
>
    <link slot="head" rel="preconnect" href={portalUrl} crossorigin="anonymous" />
    <main>
        <LiveProgress portalUrl={portalUrl} client:load />
        <noscript>
            <p class="mx-auto max-w-xl px-4 pb-16 text-center">
                Live progress needs JavaScript to stream updates from the team
                portal.
            </p>
        </noscript>
    </main>
</Layout>
