---
/*
 * OUR TEAM PAGE
 *
 * Adding / editing people: edit `sections` below, same as always
 * ({ name, roles, image?, badges? }). Each person becomes a card
 * (Person.astro): name, photo, position and their badges; clicking a card
 * opens that person's profile. A name listed twice in a section is one card
 * with both positions and both lists of badges.
 *
 * Badges are the short titles under the position, one line each on what
 * the person does or did ("Mission Commander — Team lead and competition
 * robot"). Base them on their real work (finished portal tasks, what they
 * own on the team); the business team keeps them current. Each one is
 * { title, description, icon?, tone? }: icons are listed in
 * src/components/team/badges.ts (crown, cpu, wrench, cog, code, bot,
 * gamepad, globe, palette, megaphone, …), tones are "gold", "green", "teal"
 * and "violet" (default: gold for captains and leads, else their subteam's).
 *
 * Photos come from the Teammate Portal automatically: each teammate uploads
 * their own photo in the portal (Settings -> My photo) and it shows on their
 * card, in their profile and next to their name on /progress (which knows
 * only portal photos) — nothing to do here. It's matched
 * by name like the live numbers (the name here must equal their name in the
 * portal; case, spaces and accents ignored — the portal sends a hash of each
 * name, never the name, and the site hashes the names below the same way)
 * and shows while they leave "Show my photo on the team website" on, nobody
 * who manages their account holds it off in the portal (Admin -> People;
 * renaming yourself in the portal holds it until a leader checks the new
 * name), and the portal's "Show members' photos on the team website" is on
 * (Admin -> Team website). Turning either off (or removing the photo) takes
 * it off the site within a few minutes; no rebuild. The folder photo and an
 * explicit `image` still work: `image` overrides the portal photo, the
 * folder photo is the fallback for anyone without one.
 *
 * Which photo a card shows:
 *   1. `image` on the entry, when set — always, even if they have a portal
 *      photo (use it to override);
 *   2. their portal photo;
 *   3. a photo in src/assets/images/people/ named after them (the fallback
 *      for people without a portal photo, e.g. before they upload one);
 *   4. their initials.
 *
 * Adding a photo here instead: put it in src/assets/images/people/ and name
 * the file after the person: their name in lowercase, spaces -> hyphens,
 * accents removed, apostrophes dropped. .png, .jpg, .jpeg or .webp:
 *     Tommy Ho        -> tommy-ho.jpg
 *     Wolfgang Lengsfeld -> wolfgang-lengsfeld.png
 *     José O'Neil     -> jose-oneil.webp
 * It's picked up automatically at build time, cropped square from the top
 * and resized (no code change needed). Or set `image` on an entry to use a
 * file with another name from that folder (image: "ethan.png"), a file in
 * public/ (image: "/images/x.jpg") or a link (image: "https://…").
 * Only exact names match: ethan.png matches nobody on its own (no one here is
 * called just "Ethan").
 *
 * Before adding a photo to the folder:
 *   - Ask the teammate first: this repo and the site are public.
 *   - Remove location data (phones put GPS in the file): export it without
 *     location, or run  exiftool -all= -overwrite_original <file>.  The build
 *     warns about a photo that still has EXIF or GPS data.
 * Every file in that folder is public in the GitHub repo. A file that matches
 * nobody (say, someone who left) isn't shown and the build leaves it out of
 * the site, with a "[team] … matches nobody" warning: delete it from the repo
 * too.
 *
 * Live numbers: the "Team progress — live" band, the "12 done" meter on each
 * card and the profile's stats and finished tasks come from the Teammate
 * Portal's public progress (/progress uses the same data). A card gets live
 * numbers when its name here equals the person's name in the portal (case,
 * spaces and accents ignored). That works while the portal shows full names
 * (Admin -> Team website -> name style "full", the default); with initials
 * or hidden names the cards just show no live numbers (and /progress doesn't
 * link people here). A profile lists what someone finished only while the
 * portal's "Show each person's profile on the Our Team page" is on (Admin ->
 * Team website); otherwise it shows their numbers. Share a profile with
 * /about/team?person=tommy-ho.
 */
import { PUBLIC_PORTAL_URL } from "astro:env/client";
import Person from "../../components/Person.astro";
import type { Badge } from "../../components/team/badges";
import { resolvePhoto, warnUnusedPhotos } from "../../components/team/photos";
import { buildRoster, slugify } from "../../components/team/roster";
import TeamLive from "../../components/team/team-live";
import Layout from "../../layouts/Layout.astro";
import "../../styles/progress.css";
import "../../styles/team.css";

interface PersonData {
    name: string;
    roles: string[];
    image?: string;
    badges?: Badge[];
}

// roles
const captain = "Team Captain";
const coCaptain = "Co-Captain";
const buildLead = "Build Lead";
const businessLead = "Business Lead";
const softwareLead = "Software Lead";
const buildTeam = "Build Team";
const softwareTeam = "Software Team";
const businessTeam = "Business Team";
const designTeam = "Design Team";
const alumni = "Alumni";
const mentor = "Mentor";

// string sorting functions for alphabetical order of names
const compareStrings = (a: string, b: string) => {
    if (a < b) return -1;
    if (a > b) return 1;

    return 0;
};

const compare = (a: string, b: string) => {
    const splitA = a.split(" ");
    const splitB = b.split(" ");
    const lastA = splitA[splitA.length - 1];
    const lastB = splitB[splitB.length - 1];

    return lastA === lastB
        ? compareStrings(splitA[0], splitB[0])
        : compareStrings(lastA, lastB);
};

// Badges shared by everyone who worked on the same task.
// portal: "Simple Parking Autonomous" (Oct 5): Stephen Yuan's task; the other
// software members' items on it were checked off when it finished.
const parkingAuto: Badge = {
    icon: "bot",
    tone: "teal",
    title: "Autonomous Coder",
    description: "Simple parking autonomous routine",
};
// portal: "Drivetrain Construction" (Oct 1 and Oct 3)
const driveTrain: Badge = {
    icon: "cog",
    tone: "green",
    title: "Drivetrain Builder",
    description: "Built the robot's drivetrain",
};

// Badges marked "portal" come from tasks finished in the Teammate Portal;
// the business team fills in and updates the rest.
const sections: { title: string; people: PersonData[] }[] = [
    {
        title: "Leadership",
        people: [
            {
                name: "Tommy Ho",
                roles: [captain],
                badges: [
                    {
                        icon: "crown",
                        tone: "gold",
                        title: "Mission Commander",
                        description: "Team lead and competition robot",
                    },
                    {
                        icon: "cpu",
                        tone: "teal",
                        title: "Tech Architect",
                        description: "CAD mentor, inventory and portal dev",
                    },
                ],
            },
            { name: "Ethan Zhang", roles: [buildLead] },
            { name: "Wolfgang Lengsfeld", roles: [buildLead] },
            { name: "Gwen Lengsfeld", roles: [businessLead] },
            {
                name: "Jack Luo",
                roles: [softwareLead],
                badges: [
                    // portal: "TeleOp" (Sep 30)
                    {
                        icon: "gamepad",
                        tone: "teal",
                        title: "TeleOp Programmer",
                        description: "Driver-controlled robot code",
                    },
                    // portal: "Website - The Workshop" (Oct 4)
                    {
                        icon: "globe",
                        tone: "teal",
                        title: "Web Developer",
                        description: "Built the website's Workshop page",
                    },
                ],
            },
            {
                name: "Grant Story",
                roles: [buildLead],
                badges: [driveTrain],
            },
        ],
    },
    {
        title: "Members",
        people: [
            { name: "Maximus Ku", roles: [buildTeam] },
            { name: "Tim Jung", roles: [buildTeam] },
            { name: "Michael Hyodo", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Tim Jung", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Elizabeth Hyodo", roles: [businessTeam] },
            { name: "Viraaj Gaggar", roles: [businessTeam] },
            { name: "Alivia Hsu", roles: [businessTeam] },
            { name: "Jason Luo", roles: [businessTeam] },
            {
                name: "Tiffany Yang",
                roles: [businessTeam],
                badges: [
                    // portal: "Awards poster" (Oct 1)
                    {
                        icon: "palette",
                        tone: "violet",
                        title: "Poster Designer",
                        description: "Designed our awards poster",
                    },
                ],
            },
            { name: "Felix Gu", roles: [softwareTeam] },
            { name: "Jack Hu", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Brandon Shu", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Alice Wang", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Frank Wang", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Stephen Yuan", roles: [softwareTeam], badges: [parkingAuto] },
            { name: "Paige Bantz", roles: [buildTeam], badges: [driveTrain] },
            { name: "Daksh Bhatnagar", roles: [buildTeam] },
            { name: "Jaylen Hon", roles: [buildTeam] },
            { name: "Will Li", roles: [buildTeam] },
            { name: "William Man", roles: [buildTeam] },
            { name: "Ian Nguyen", roles: [buildTeam] },
            { name: "Aden Nunes", roles: [buildTeam] },
            { name: "Aaron Sun", roles: [buildTeam] },
        ],
    },
];

// ---- Page plumbing below: nothing to edit when adding people or photos ----

const portalUrl = PUBLIC_PORTAL_URL.replace(/\/+$/, "");

// Build log: photos in src/assets/images/people/ that match nobody here.
warnUnusedPhotos(sections.flatMap((section) => section.people));

// One card per person in each section (a name listed twice in a section is
// one card with both positions and badges).
const cardSections = sections.map(({ title, people }) => ({
    title,
    people: buildRoster([{ title, people }]),
}));

// Everyone once (a name listed twice is one person with both positions),
// with the large photo for their profile dialog and where it came from.
const roster = await Promise.all(
    buildRoster(sections).map(async (person) => {
        const image = person.entries.find((entry) => entry.image)?.image;
        const photo = await resolvePhoto(person.name, image);
        return {
            slug: person.slug,
            name: person.name,
            roles: person.roles,
            lead: person.lead,
            badges: person.badges,
            photo: photo?.large ?? null,
            // "image" keeps its photo even when they have a portal photo.
            photoSource: photo?.source ?? null,
        };
    }),
);

const headingId = (title: string) =>
    `team-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<Layout
    title="Our Team | The Huskyteers | FTC 19516"
    description="Meet The Huskyteers, FTC team 19516 from Fairmont Preparatory Academy: our leadership and members, with live progress from our Teammate Portal."
>
    <!-- Two warm connections: the JSON is a CORS fetch, the portal photos are
         plain <img> requests, and browsers keep those in separate pools. -->
    <link slot="head" rel="preconnect" href={portalUrl} crossorigin="anonymous" />
    <link slot="head" rel="preconnect" href={portalUrl} />
    <main class="hud hud-bg min-h-screen">
        <div
            class="relative mx-auto max-w-7xl px-4 pt-10 pb-16 sm:px-6 lg:px-8 lg:pt-14"
        >
            <header class="max-w-3xl">
                <p
                    class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-base-content/65"
                    data-edit-text="team.header.kicker"
                    data-edit-label="Our Team: small line above the title"
                >
                    FTC 19516 // The people
                </p>
                <h1
                    class="mt-2 font-jockey text-6xl leading-[0.9] uppercase sm:text-7xl lg:text-8xl"
                >
                    <span
                        class="text-base-content"
                        data-edit-text="team.header.title-start"
                        data-edit-label="Our Team: title (white part)"
                        >Our</span
                    >{" "}<span
                        class="hud-title-accent"
                        data-edit-text="team.header.title-accent"
                        data-edit-label="Our Team: title (green part)"
                        >Team</span
                    >
                </h1>
                <p
                    class="mt-5 text-base text-base-content/80 sm:text-lg"
                    data-edit-text="team.header.intro"
                    data-edit-label="Our Team: intro text"
                    data-edit-multiline
                >
                    We are an FTC team from Fairmont Preparatory Academy, entering
                    our third year in the FIRST Tech Challenge. Combining business
                    and technical skills, our team thrives on collaboration and
                    innovation, driven by strong bonds and a shared commitment to
                    STEM excellence.
                </p>
                <p
                    class="mt-4 text-base text-base-content/80 sm:text-lg"
                    data-edit-text="team.header.mission"
                    data-edit-label="Our Team: mission text"
                    data-edit-multiline
                >
                    Fairmont Prep Robotics is dedicated to building a culture of teamwork
                    and creativity. Our mission is to inspire future STEM leaders, excel
                    in FIRST programs, and make a meaningful impact on our school and
                    community.
                </p>
            </header>

            <TeamLive portalUrl={portalUrl} roster={roster} client:load />

            {
                cardSections.map(({ title, people }) => (
                    <section
                        aria-labelledby={title ? headingId(title) : undefined}
                        class="mt-14"
                    >
                        {title && (
                            <div class="mb-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
                                <h2
                                    id={headingId(title)}
                                    class="font-jockey text-4xl uppercase text-base-content sm:text-5xl"
                                    data-edit-text={`team.section.${slugify(title)}.title`}
                                    data-edit-label={`Our Team: "${title}" heading`}
                                >
                                    {title}
                                </h2>
                                <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-base-content/65">
                                    {people.length}{" "}
                                    {people.length === 1 ? "person" : "people"}
                                    <span class="max-sm:hidden">
                                        {" "}
                                        ·{" "}
                                        <span
                                            data-edit-text="team.section-hint"
                                            data-edit-label="Our Team: hint next to the head count"
                                        >
                                            select anyone for their profile
                                        </span>
                                    </span>
                                </p>
                            </div>
                        )}
                        <ul class="team-grid" role="list">
                            {people
                                // .toSorted((a, b) => compare(a.name, b.name))
                                .map((person) => (
                                    <li>
                                        <Person
                                            name={person.name}
                                            roles={person.roles}
                                            image={
                                                person.entries.find((e) => e.image)
                                                    ?.image
                                            }
                                            lead={person.lead}
                                            badges={person.badges}
                                            tone={person.tone}
                                        />
                                    </li>
                                ))}
                        </ul>
                    </section>
                ))
            }

            <noscript>
                <p class="mt-10 text-sm text-base-content/70">
                    Profiles and live progress need JavaScript.
                </p>
            </noscript>
        </div>
    </main>
</Layout>
