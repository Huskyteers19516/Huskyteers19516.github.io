---
import Layout from "../../layouts/Layout.astro";

// Every text here can also be changed from the Teammate Portal
// (Admin -> Website Coding); what's written here is the default.
const participants = [
    {
        key: "students",
        who: "Students (grades 7-12)",
        what: "The core team members who design, build, and program the robot.",
    },
    {
        key: "mentors",
        who: "Mentors and Coaches",
        what: "Often volunteer engineers, educators, or parents who guide teams through technical development and strategy.",
    },
    {
        key: "volunteers",
        who: "Volunteers and Event Staff",
        what: "Assist with running events and supporting teams throughout the season.",
    },
    {
        key: "first",
        who: "FIRST Organization & Regional Partners",
        what: "They set the rules, game themes, organize the season, provide resources, and manage progression through the competition hierarchy.",
    },
];

const gameParts = [
    {
        key: "autonomous",
        title: "Autonomous (30 s)",
        text: "Robots decode motif, score artifacts, build patterns, move off launch line",
    },
    {
        key: "driver",
        title: "Driver-Control (2 min)",
        text: "Teams collect and score artifacts, finish pattern, return robots to base",
    },
    {
        key: "scoring",
        title: "Scoring",
        text: "Points for artifacts, patterns, maze decoding, robot returns; ranking points also",
    },
    {
        key: "strategy",
        title: "Strategic Themes",
        text: "Randomization, teamwork, dual-phase planning, cooperative gameplay",
    },
];
---

<Layout>
    <main
        class="flex flex-col items-center pt-8 w-full min-h-screen container mx-auto mb-10 text-center"
    >
        <div class="w-full px-5">
            <h1
                class="font-bold text-4xl mb-5"
                data-edit-text="ftc.title"
                data-edit-label="What is FTC: page title"
            >
                What is FTC?
            </h1>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 text-left">
                <div>
                    <h2
                        class="text-2xl mb-5 text-primary"
                        data-edit-text="ftc.basics.title"
                        data-edit-label="What is FTC: basics heading"
                    >
                        Basics of FTC
                    </h2>
                    <p
                        data-edit-text="ftc.basics.text"
                        data-edit-label="What is FTC: basics text"
                        data-edit-multiline
                    >
                        FIRST Tech Challenge is an international robotics
                        competition designed for students in grades 7-12. Teams
                        design, build, and program robots to compete
                        head-to-head in alliance-based matches. The competition
                        includes local qualifiers, regional/state championships,
                        and culminates at the world-level FIRST Championship.
                        Teams are also judged in areas such as design, community
                        outreach, and technical innovation.
                    </p>
                </div>
                <div>
                    <h2
                        class="text-2xl mb-5 text-primary"
                        data-edit-text="ftc.participants.title"
                        data-edit-label="What is FTC: who participates heading"
                    >
                        Who Participates
                    </h2>
                    <ul class="list-inside list-disc space-y-2">
                        {
                            participants.map(({ key, who, what }) => (
                                <li>
                                    <span
                                        class="text-primary"
                                        data-edit-text={`ftc.participants.${key}.who`}
                                        data-edit-label={`What is FTC: ${who} (name)`}
                                    >
                                        {who}
                                    </span>{" "}
                                    :{" "}
                                    <span
                                        data-edit-text={`ftc.participants.${key}.what`}
                                        data-edit-label={`What is FTC: ${who} (description)`}
                                        data-edit-multiline
                                    >
                                        {what}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div>
                    <h2
                        class="text-2xl mb-5 text-primary"
                        data-edit-text="ftc.game.title"
                        data-edit-label="What is FTC: game heading"
                    >
                        Decode 2025-26 Game
                    </h2>
                    {
                        gameParts.map(({ key, title, text }) => (
                            <>
                                <h2
                                    class="text-xl mb-2 text-primary"
                                    data-edit-text={`ftc.game.${key}.title`}
                                    data-edit-label={`What is FTC: ${title} (heading)`}
                                >
                                    {title}
                                </h2>
                                <p
                                    class="mb-2"
                                    data-edit-text={`ftc.game.${key}.text`}
                                    data-edit-label={`What is FTC: ${title} (text)`}
                                    data-edit-multiline
                                >
                                    {text}
                                </p>
                            </>
                        ))
                    }
                </div>
            </div>
        </div>
    </main>
</Layout>
