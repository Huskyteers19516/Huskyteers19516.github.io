---
import Layout from "../../layouts/Layout.astro";

// Every name, text and photo here can also be changed from the Teammate
// Portal (Admin -> Website Coding); what's written here is the default.
// A mentor's photo shows only once one is added in the portal.
const mentors = [
    {
        key: "ramirez",
        name: "Ms. Ramirez",
        about: "is our lead coach and comp sci teacher at Fairmont Prep. She always emphasizes the importance of creativity as a team.",
    },
    {
        key: "lengsfeld",
        name: "Mr. Lengsfeld",
        about: "works by advising all our sub-teams in technical challenges, and how we can improve the Huskyteers as a single unit.",
    },
    {
        key: "fawcett",
        name: "Mr. Fawcett",
        about: "helps us with the design of our robot, and ensures that we stay organized by promoting good build practices.",
    },
];

const initialOf = (name: string) =>
    name.replace(/^(Mr|Ms|Mrs|Dr)\.?\s+/i, "").charAt(0).toUpperCase();
---

<Layout>
    <main
        class="flex flex-col items-center pt-8 w-full min-h-screen container mx-auto mb-10 text-center"
    >
        <div class="max-w-3xl px-5 w-full">
            <h1
                class="font-bold text-4xl mb-5"
                data-edit-text="mentors.title"
                data-edit-label="Mentors: page title"
            >
                Mentors
            </h1>
            <ul class="list-inside list-disc space-y-4 text-left">
                {
                    mentors.map(({ key, name, about }) => (
                        <li class="overflow-hidden">
                            <span class="float-left mr-4 mb-2" data-edit-optional hidden>
                                <span
                                    class="flex size-20 items-center justify-center rounded-full bg-base-200 text-2xl font-bold text-primary ring-2 ring-primary/40"
                                    data-edit-image={`mentors.${key}.photo`}
                                    data-edit-label={`Mentors: photo of ${name}`}
                                    data-edit-img-class="size-20 rounded-full object-cover"
                                >
                                    <span aria-hidden="true">{initialOf(name)}</span>
                                </span>
                            </span>
                            <strong
                                data-edit-text={`mentors.${key}.name`}
                                data-edit-label={`Mentors: ${name} (name)`}
                            >
                                {name}
                            </strong>{" "}
                            <span
                                data-edit-text={`mentors.${key}.about`}
                                data-edit-label={`Mentors: ${name} (text)`}
                                data-edit-multiline
                            >
                                {about}
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </main>
</Layout>
