---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/common/Hero.astro';
import SubsystemViewer from '../components/robot/SubsystemViewer.astro';
import AutonomousVisualizer from '../components/robot/AutonomousVisualizer.astro';
import FtcScoutWidget from '../components/matches/FtcScoutWidget.astro';
import ImpactMap from '../components/outreach/ImpactMap.astro';
import { siteConfig } from '../config/site.config';
import sponsorsData from '../data/sponsors.json';
import Icon from '../components/common/Icon.astro';
---

<Layout>
  <!-- Hero Section -->
  <Hero />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">
    
    <!-- Robot & Auto Spotlight Section -->
    {siteConfig.features.robotShowcase && (
      <section class="space-y-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--brand-primary-light)] mb-1">
              <Icon name="bot" size={16} />
              <span>Engineering Excellence</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
              Meet NectarViper V3
            </h2>
          </div>
          <a href="/robot" class="text-xs font-bold text-[var(--brand-primary-light)] hover:underline flex items-center gap-1 self-start sm:self-auto">
            <span>Full Technical Specifications</span>
            <Icon name="chevron-right" size={14} />
          </a>
        </div>

        <SubsystemViewer />

        {siteConfig.features.autonomousVisualizer && (
          <div class="pt-6">
            <AutonomousVisualizer />
          </div>
        )}
      </section>
    )}

    <!-- Match Hub & Live OPR Rating -->
    {siteConfig.features.ftcScoutLiveWidget && (
      <section class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--brand-accent)] mb-1">
              <Icon name="trophy" size={16} />
              <span>Competition Record</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
              Match Hub & Standings
            </h2>
          </div>
          <a href="/matches" class="text-xs font-bold text-[var(--brand-accent)] hover:underline flex items-center gap-1 self-start sm:self-auto">
            <span>View All Tournaments & Awards</span>
            <Icon name="chevron-right" size={14} />
          </a>
        </div>

        <FtcScoutWidget />
      </section>
    )}

    <!-- Community Outreach Section -->
    {siteConfig.features.outreachTimeline && (
      <section class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-cyan-400 mb-1">
              <Icon name="heart-handshake" size={16} />
              <span>Connect & Motivate</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white">
              Community Outreach & Impact
            </h2>
          </div>
          <a href="/outreach" class="text-xs font-bold text-cyan-400 hover:underline flex items-center gap-1 self-start sm:self-auto">
            <span>Explore All Workshops</span>
            <Icon name="chevron-right" size={14} />
          </a>
        </div>

        <ImpactMap />
      </section>
    )}

    <!-- Sponsor Logo Banner -->
    {siteConfig.features.sponsorsGrid && (
      <section class="p-8 sm:p-12 rounded-3xl glass-card border border-white/10 text-center space-y-8">
        <div>
          <span class="text-xs uppercase font-bold tracking-widest text-slate-400">Powered by our generous partners</span>
          <h3 class="text-2xl font-bold font-display text-white mt-1">2025-2026 Season Sponsors</h3>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-center">
          {sponsorsData.currentSponsors.map((sponsor) => (
            <a 
              href={sponsor.website} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 hover:border-white/20 transition-all flex flex-col items-center justify-center min-h-[90px] group"
            >
              <span class="text-xs font-bold text-slate-300 group-hover:text-white transition-colors text-center">{sponsor.name}</span>
              <span class="text-[9px] text-[var(--brand-accent)] uppercase font-semibold mt-1">{sponsor.tier}</span>
            </a>
          ))}
        </div>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a 
            href="/sponsors" 
            class="px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-light)] transition-all shadow-md"
          >
            Become a Sponsor
          </a>
          {siteConfig.links.sponsorshipDeckPdf && (
            <a 
              href={siteConfig.links.sponsorshipDeckPdf} 
              target="_blank"
              class="px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-300 bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-1.5"
            >
              <Icon name="download" size={14} />
              <span>Download Packet (PDF)</span>
            </a>
          )}
        </div>
      </section>
    )}

  </div>
</Layout>
