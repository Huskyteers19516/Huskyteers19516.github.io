---
import { Image } from "astro:assets";
import { Instagram, Discord } from "simple-icons-astro";
import Mail from "@lucide/astro/icons/mail";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Layout from "../layouts/Layout.astro";
import TeamImage from "../assets/images/contact/team.jpg";
import InstagramQrCode from "../assets/images/contact/instagram-qr.png";

const email = "diramirez@fairmontschools.com";

const cards = [
    {
        key: "instagram",
        title: "Follow us on Instagram",
        description:
            "See what we're building, competition recaps and outreach events.",
        href: "https://www.instagram.com/ftc19516/",
        cta: "@ftc19516",
        icon: Instagram,
        external: true,
    },
    {
        key: "discord",
        title: "Join our Discord",
        description:
            "Join our public general channel to meet the Huskyteers community, ask questions and chat about FTC.",
        href: "https://discord.gg/9a7y4MpE6",
        cta: "Join the server",
        icon: Discord,
        external: true,
    },
    {
        key: "email",
        title: "Email Us",
        description:
            "Questions, comments or sponsorship inquiries? We'd love to hear from you.",
        href: `mailto:${email}`,
        cta: email,
        icon: Mail,
        external: false,
    },
];
---

<Layout title="Contact Us | The Huskyteers | FTC 19516">
    <main
        class="flex flex-col items-center pt-8 w-full min-h-screen container mx-auto mb-10 px-4 text-center"
    >
        <h1
            class="font-bold text-4xl mb-5"
            data-edit-text="contact.title"
            data-edit-label="Contact: page title"
        >
            Contact Us
        </h1>

        <Image
            src={TeamImage}
            alt="The Huskyteers 19516 team"
            class="w-full max-w-5xl h-auto rounded-xl shadow-lg"
            data-edit-image="contact.team-photo"
            data-edit-label="Contact: team photo"
        />

        <div class="w-full max-w-5xl mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                cards.map(({ key, title, description, href, cta, icon: Icon, external }) => (
                    <a
                        href={href}
                        data-edit-link={`contact.${key}.link`}
                        data-edit-label={`Contact: ${title} (link)`}
                        target={external ? "_blank" : undefined}
                        rel={external ? "noopener noreferrer" : undefined}
                        class="card min-w-0 bg-base-200 border border-base-content/10 transition hover:-translate-y-1 hover:border-primary hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                    >
                        <div class="card-body items-center text-center">
                            <Icon size={36} class="text-primary" aria-hidden="true" />
                            <h2
                                class="card-title mt-2"
                                data-edit-text={`contact.${key}.title`}
                                data-edit-label={`Contact: ${title} (title)`}
                            >
                                {title}
                            </h2>
                            <p
                                class="flex-none text-base-content/75"
                                data-edit-text={`contact.${key}.text`}
                                data-edit-label={`Contact: ${title} (text)`}
                                data-edit-multiline
                            >
                                {description}
                            </p>
                            {key === "instagram" && (
                                <Image
                                    src={InstagramQrCode}
                                    alt="Scan this QR code to follow the Huskyteers on Instagram"
                                    format="png"
                                    class="my-2 w-48 max-w-full h-auto rounded-lg bg-white"
                                    data-edit-image="contact.instagram.qr-code"
                                    data-edit-label="Contact: Instagram QR code"
                                />
                            )}
                            <span class="mt-auto pt-2 inline-flex items-center gap-1 font-medium text-primary break-all">
                                <span
                                    data-edit-text={`contact.${key}.cta`}
                                    data-edit-label={`Contact: ${title} (button text)`}
                                >
                                    {cta}
                                </span>
                                {external && <ArrowUpRight size={16} class="shrink-0" aria-hidden="true" />}
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</Layout>
